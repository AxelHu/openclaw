{
  "id": "agentchat",
  "version": "0.1.0",
  "channels": ["agentchat"],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean",
        "default": true
      },
      "serverUrl": {
        "type": "string",
        "description": "WebSocket server URL (e.g. ws://localhost:20203)"
      },
      "restUrl": {
        "type": "string",
        "description": "REST API base URL (e.g. http://localhost:20202)"
      },
      "healthMonitor": {
        "type": "object",
        "description": "Health monitor settings"
      },
      "accounts": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "properties": {
            "username": { "type": "string" },
            "password": { "type": "string" },
            "agentId": { "type": "string" },
            "agentName": { "type": "string" },
            "requireMention": { "type": "boolean" },
            "botName": { "type": "string" }
          },
          "required": ["username", "password", "agentId"],
          "additionalProperties": false
        }
      },
      "requireMention": {
        "type": "boolean",
        "default": true
      }
    },
    "required": ["serverUrl", "restUrl", "accounts"]
  }
}
